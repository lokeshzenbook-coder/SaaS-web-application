# Server
HOST=0.0.0.0
PORT=3000
NODE_ENV=development

# Security — generate a long random value for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production

# Auth
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Rate limiting (global, applies to /api/auth)
RATE_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Database
# DB_FILE=data/saas.db
